{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口 WebView（main）中页面脚本可调用的权限，只包含主界面实际调用的命令。插件权限只保留 core:default 与拖动标题栏：dialog、shell、opener 插件由 Rust 侧直接调用，不经过这层授权，授予 WebView 只会使被注入的脚本获得这些能力。按 webview 而不是按 window 授权：主窗口下附加着浏览器宿主的外部网页子视图，按 window 授权时它们同样获得这些权限。",
  "webviews": ["main"],
  "permissions": [
    "allow-app-update",
    "core:default",
    "core:window:allow-start-dragging",
    "allow-pick-workspace",
    "allow-pick-files",
    "allow-list-skill-sources",
    "allow-save-session-export",
    "allow-reveal-workspace",
    "allow-reveal-file",
    "allow-desktop-open-settings",
    "allow-remember-workspace",
    "allow-window-minimize",
    "allow-window-toggle-maximize",
    "allow-window-close",
    "allow-window-is-maximized",
    "allow-terminal-open",
    "allow-terminal-list",
    "allow-terminal-write",
    "allow-terminal-resize",
    "allow-terminal-close",
    "allow-browser-tabs",
    "allow-browser-open",
    "allow-browser-close",
    "allow-browser-navigate",
    "allow-browser-activate",
    "allow-browser-layout",
    "allow-pet-window-show",
    "allow-pet-window-hide"
  ]
}
