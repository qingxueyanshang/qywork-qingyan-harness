{
  "env": {
    "CLAUDE_SCRATCHPAD": ".tmp/scratch"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun run scripts/session-env.ts"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bun run scripts/guard-real-home.ts"
          }
        ]
      }
    ]
  }
}
