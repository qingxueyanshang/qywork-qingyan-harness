{
  "name": "qywork",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "description": "qywork — 开源本地编程 agent：Tauri 2 外壳 + Bun agent 内核 + Solid UI，桌面与移动同协议",
  "license": "Apache-2.0",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:agent": "bun --watch packages/cli/src/index.ts serve --port 7717 --host 127.0.0.1",
    "dev:web": "bun run --cwd apps/web dev",
    "build": "bun run build:web && bun run build:agent",
    "build:web": "bun run --cwd apps/web build",
    "build:agent": "bun run scripts/build-sidecar.ts",
    "tauri:dev": "bun run scripts/dev.ts",
    "tauri:build": "bun run build:agent && bun run --cwd apps/desktop tauri build && bun run scripts/collect-installer.ts",
    "gate": "bun run typecheck && biome check . && bun run test && bun run typecheck:rust",
    "typecheck": "tsc --build --force && bun run --cwd apps/web typecheck",
    "typecheck:rust": "cargo check --quiet --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "test": "bun run scripts/run-tests.ts",
    "check": "biome check --write .",
    "version:sync": "bun run scripts/sync-version.ts",
    "smoke:serve": "bun run scripts/smoke-serve.ts",
    "smoke:responses": "bun run scripts/smoke-responses.ts",
    "smoke:compaction": "bun run scripts/compaction-fidelity.ts",
    "smoke:context": "bun run scripts/context-scale-live.ts",
    "seed:demo": "bun run scripts/seed-demo.ts",
    "shoot": "node scripts/shoot-ui.mjs",
    "check:attachments": "node scripts/check-attachments.mjs",
    "icon": "node scripts/make-icon.mjs && bun run --cwd apps/desktop tauri icon ../../.tmp/icon/source.png"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-typescript": "^7.27.0",
    "@biomejs/biome": "2.3.5",
    "@happy-dom/global-registrator": "^20.11.6",
    "@qywork/ai": "workspace:*",
    "@qywork/core": "workspace:*",
    "@qywork/runtime": "workspace:*",
    "@qywork/server": "workspace:*",
    "@qywork/store": "workspace:*",
    "@types/babel__core": "^7.20.5",
    "@types/bun": "1.3.14",
    "babel-preset-solid": "^1.9.15",
    "happy-dom": "^20.11.6",
    "playwright": "^1.62.1",
    "typescript": "5.9.3"
  }
}
