{
  "name": "qywork",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "qywork — 开源 codex 级本地编程 agent：Tauri 2 外壳 + Bun agent 内核 + Solid UI，桌面与移动同协议",
  "license": "Apache-2.0",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/web"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:agent": "bun run --cwd packages/server dev",
    "dev:web": "bun run --cwd apps/web dev",
    "build": "bun run build:web && bun run build:agent",
    "build:web": "bun run --cwd apps/web build",
    "build:agent": "bun run scripts/build-sidecar.ts",
    "tauri:dev": "bun run --cwd apps/desktop tauri dev",
    "tauri:build": "bun run --cwd apps/desktop tauri build",
    "typecheck": "tsc --build --force",
    "test": "bun test",
    "check": "biome check --write .",
    "version:sync": "bun run scripts/sync-version.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.5",
    "@qywork/core": "workspace:*",
    "@qywork/runtime": "workspace:*",
    "@qywork/server": "workspace:*",
    "@qywork/store": "workspace:*",
    "@types/bun": "1.3.14",
    "playwright": "^1.62.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@qywork/agent": "workspace:*",
    "@qywork/ai": "workspace:*",
    "@qywork/core": "workspace:*",
    "@qywork/runtime": "workspace:*",
    "@qywork/server": "workspace:*",
    "@qywork/store": "workspace:*",
    "@qywork/tools": "workspace:*",
    "@qywork/mcp": "workspace:*"
  }
}
