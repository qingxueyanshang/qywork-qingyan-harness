node_modules/
dist/
dist-*/
target/
*.tsbuildinfo
.DS_Store
Thumbs.db

# 本地运行时数据。
#
# 全局数据在**用户主目录** `~/.qywork/`（可用 QYWORK_HOME 改），
# 见 packages/runtime/src/config.ts:107 —— config.json / qywork.sqlite3 /
# schedules.json / last-workspace 都在那里，本来就不在仓库里。
# 这里留一条 `.qywork/` 是防 QYWORK_HOME 被指到仓库内（跑测试时会）。
.qywork/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# 工作区级配置 `<workspace>/.qy/`：
# mcp.json 与 team.json 是**项目配置，应当入库**；plugins/ 是装进来的产物，不入库。
.qy/plugins/

# 密钥与本地配置
.env
.env.local
*.local.json

# 构建产物
apps/desktop/src-tauri/bin/
apps/web/dist/
packages/*/dist/
# tauri-build 每次构建重生成；`capabilities/default.json` 只把它当 IDE 的 $schema 指针用。
apps/desktop/src-tauri/gen/

# 脚本的临时工作区与产物。全部落 `.tmp/<用途>`，根目录不再各开一个点目录；
# 由 scripts/temp-dir.test.ts 在门禁里扫住。
.tmp/

# agent 运行态（.claude/memory/ 是项目记忆，要入库）
.claude/*.lock
scripts/dist/

# 方案、复审、执行记录（CLAUDE.md A3/A4）。
#
# 留在本地，不入库：它们逐条引用外部参照实现的 `文件:行号` 与本机绝对路径，
# 那是取证过程，不是这个仓库对外承诺的东西。公开的是结论——落在
# `ARCHITECTURE.md`（为什么这么做）与代码注释（用途与坑）里。
ROADMAP.md
docs/plans/
